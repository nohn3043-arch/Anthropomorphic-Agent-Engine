# 1. SujinMapper — 苏瑾专属的"世界观滤镜"
#    同一个事件，不同的人感受到的东西不同。
#    苏瑾作为资深顾问，她的认知偏见是：
#      - 对夸奖持保留（"可能是客套，也可能是期待回报"）
#      - 对批评认真对待（涉及专业尊严）
#      - 对信任信号珍视（"愿意合作比愿意夸奖重要得多"）
#      - 有确认偏见——已有经验会放大对类似情况的判断
# ════════════════════════════════════════════════════════════════

class SujinMapper:
    """
    苏瑾的事件→内感受映射器。

    与默认 NarrativeMapper 不同，苏瑾：
    - 不轻信夸奖（专业顾问的防备心）
    - 对批评/质疑高度敏感（专业尊严）
    - 对信任行为（签约、长期合作）极为看重
    - 对背叛的反应是毁灭性的（信任一旦崩塌，重建极难）

    此外，她还受到"心理矩阵"的调制：
    - trust_level 低 → 严谨专业模式：belonging 增益打折，threat 感知放大
    - trust_level 高 → 深度共创模式：belonging 增益放大，threat 感知减弱
    """

    def __init__(self, core: SPLPureCoreV7_3 = None):
        """
        Args:
            core: 核心引擎引用，用于动态读取当前信任水平。
                  如果为 None，则使用静态映射（不调制）。
        """
        self.core = core

        # ── 苏瑾的价值观权重 ──
        # 这些参数定义了"苏瑾是什么样的人"
        self.dignity_sensitivity = 0.45    # 对尊严受损的敏感度
        self.skepticism = 0.35             # 对正面信号的怀疑度
        self.trust_value = 0.55            # 对信任信号的珍视度
        self.betrayal_scar = 0.75          # 对背叛的创伤放大系数

        # ── 心理矩阵相关参数 ──
        # 从 sujin-demo 原始设计继承的互斥组
        self.rigorous_start = 3.0   # 严谨专业：初始权重
        self.rigorous_end = 0.2     # 严谨专业：高信任时权重
        self.empower_start = 0.0    # 深度共创：初始权重
        self.empower_end = 3.5      # 深度共创：高信任时权重
        self.risk_start = 1.5       # 风险控制：初始权重
        self.risk_end = 0.4         # 风险控制：高信任时权重

    def _trust_level(self) -> float:
        """获取归一化信任水平 [0, 1]。
        用 fluid["信任"] / max_trust 来反映"当前信任占最大可能信任的比例"。
        """
        if self.core is None:
            return 0.3  # 默认：中等偏低信任
        max_t = max(self.core.max_trust, 0.01)
        raw = self.core.fluid.get("信任", 0.3)
        return min(1.0, raw / max_t)

    def _sigmoid(self, x: float, threshold: float = 0.3,
                 sensitivity: float = 2.0) -> float:
        """用 sigmoid 平滑地从一个权重过渡到另一个权重。
        模拟心理矩阵中 start_weight → end_weight 的连续曲线。
        """
        return 1.0 / (1.0 + math.exp(-sensitivity * (x - threshold)))

    def _rigorous_weight(self) -> float:
        """严谨专业：信任越高 → 权重越低（sigmoid 下降）"""
        t = self._trust_level()
        s = self._sigmoid(t, threshold=0.3, sensitivity=2.0)  # [0,1]
        return self.rigorous_start + (self.rigorous_end - self.rigorous_start) * s

    def _empower_weight(self) -> float:
        """深度共创：信任越高 → 权重越高（sigmoid 上升）"""
        t = self._trust_level()
        s = self._sigmoid(t, threshold=0.35, sensitivity=1.5)
        return self.empower_start + (self.empower_end - self.empower_start) * s

    def _risk_control_weight(self) -> float:
        """风险控制：信任越高 → 权重越低"""
        t = self._trust_level()
        s = self._sigmoid(t, threshold=0.25, sensitivity=1.8)
        return self.risk_start + (self.risk_end - self.risk_start) * s

    def _mode_description(self) -> str:
        """当前处于哪个主导模式"""
        r = self._rigorous_weight()
        e = self._empower_weight()
        if r > e:
            return "严谨专业模式"
        else:
            return "深度共创赋能模式"

    def map_event(self, event: str, intensity: float = 1.0) -> dict:
        """
        把事件名翻译为核心引擎能消化的内感受向量。

        支持的事件（业务场景定制）：
        - compliment         客户夸奖
        - criticism          客户质疑专业能力
        - trust_signal       客户签字/续约/推荐（信任行为）
        - betrayal           客户泄密/背刺/毁约
        - alone              独处/复盘
        - rest               休息调整
        - high_pressure      高强度工作/连续会议
        """
        vector = {}
        trust_lv = self._trust_level()

        if event == "compliment":
            # 夸奖 → 苏瑾会想："可能是客套，但也说明认可"
            # belonging 收益被 skepticism 打折
            raw_belonging = 0.25 * intensity
            belonging = raw_belonging * (1.0 - self.skepticism)
            # 在严谨模式下，对夸奖更不以为然
            belonging *= (0.6 + 0.4 * trust_lv)
            vector = {
                "belonging": belonging,
                "threat": -0.05 * intensity,  # 轻微降低戒备
            }

        elif event == "criticism":
            # 批评 → 触动专业尊严
            # threat 被 dignity_sensitivity 放大
            th = 0.35 * intensity * (1.0 + self.dignity_sensitivity)
            bl = -0.3 * intensity * (1.0 + self.dignity_sensitivity * 0.5)
            # 严谨模式下，批评更让人紧张
            rigorous_factor = 1.0 + (1.0 - trust_lv) * 0.5
            vector = {
                "threat": th * rigorous_factor,
                "belonging": bl * rigorous_factor,
                "autonomy": -0.15 * intensity,  # 专业判断被挑战
            }

        elif event == "trust_signal":
            # 信任行为（签约/续约/推荐）→ 这是苏瑾最看重的
            # 直接提升归属感和安全感
            bl = 0.5 * intensity * (1.0 + self.trust_value)
            th = -0.2 * intensity * (1.0 + self.trust_value * 0.5)
            vector = {
                "belonging": bl,
                "threat": th,
                "autonomy": 0.1 * intensity * self.trust_value,
            }

        elif event == "betrayal":
            # 背叛 → 毁灭性打击
            # 苏瑾的 betrayal_scar 系数让伤害翻倍
            scar = 1.0 + self.betrayal_scar
            vector = {
                "belonging": -0.7 * intensity * scar,
                "threat": 0.6 * intensity * scar,
                "autonomy": -0.3 * intensity,
            }

        elif event == "alone":
            # 独处 → 苏瑾比较独立，影响不大
            # 但在信任危机后独处会放大负面思考
            current_fear = self.core.fluid.get("恐惧", 0.1) if self.core else 0.1
            vector = {
                "belonging": -0.15 * intensity * (1.0 + current_fear),
            }

        elif event == "rest":
            vector = {"fatigue": -0.45 * intensity}

        elif event == "high_pressure":
            vector = {
                "fatigue": 0.35 * intensity,
                "threat": 0.15 * intensity,
                "belonging": -0.1 * intensity,
            }

        else:
            # 未知事件：中性处理
            vector = {"belonging": 0.0, "threat": 0.0}

        return vector


